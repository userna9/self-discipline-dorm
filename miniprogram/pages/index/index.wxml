<view class="page-index">
  <!-- 问候 -->
  <view class="greet" bindtap="goToProfile">
    <view class="greet-text">
      <view class="greet-hello serif">{{greeting}}，</view>
      <view class="greet-name serif">{{nickname || '室友'}}</view>
      <view class="greet-date">{{dateStr}}</view>
    </view>
    <image class="greet-avatar" src="{{avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
  </view>

  <!-- 宿舍楼：六扇窗。到宿舍的人亮灯，登记了还没到的窗口留一圈暖光等着 -->
  <view class="building" bindtap="goToCheckin">
    <view class="canopy">
      <view class="tree t1"></view>
      <view class="tree t2"></view>
      <view class="tree t3"></view>
      <view class="tree t4"></view>
      <view class="tree t5"></view>
    </view>
    <view class="facade">
      <view class="windows">
        <view wx:for="{{[0, 1, 2, 3, 4, 5]}}" wx:key="*this"
              class="window {{index < arrivedCount ? 'lit' : (index < checkedInCount ? 'expect' : '')}}"
              style="animation-delay: {{0.25 + index * 0.16}}s">
          <view class="glow"></view>
          <view class="pane"></view>
        </view>
      </view>
      <view class="facade-foot">
        <view class="facade-line serif">
          {{arrivedCount >= totalMembers ? '六盏灯都亮了' : (arrivedCount > 0 ? '亮了 ' + arrivedCount + ' 盏灯' : (checkedInCount > 0 ? '灯还没亮，有人在路上' : '今晚还没有灯亮起'))}}
        </view>
        <view class="facade-sub">已登记 {{checkedInCount}}/{{totalMembers}}，已抽签 {{lotteryCount}}/{{totalMembers}}</view>
      </view>
    </view>
  </view>

  <view class="courtyard-entry" bindtap="goToCourtyard" hover-class="entry-hover">
    <view><view class="courtyard-kicker">六个人的小院</view><view class="courtyard-heading">养只狗，等一朵花开</view><view class="courtyard-caption">一起喂饭、养花，看看今天又闯了什么祸</view></view>
    <view class="courtyard-enter">去小院 ↗</view>
  </view>

  <!-- 入口 -->
  <view class="section-head"><text class="h">今天</text></view>
  <view class="sheet entries">
    <view class="entry" bindtap="goToCheckin" hover-class="entry-hover">
      <image class="entry-icon" src="/images/ic-checkin.png"></image>
      <view class="entry-body">
        <view class="entry-title">回寝登记</view>
        <view class="entry-desc">{{isCheckedInToday ? '今天已登记，可以随时改' : '告诉大家你今晚几点回'}}</view>
      </view>
      <view class="entry-dot" wx:if="{{!isCheckedInToday}}"></view>
      <view class="chev"></view>
    </view>

    <view class="entry" bindtap="openMealModal" hover-class="entry-hover">
      <image class="entry-icon" src="/images/ic-meal.png"></image>
      <view class="entry-body">
        <view class="entry-title">吃饭询问</view>
        <view class="entry-desc">{{mealCardDesc}}</view>
      </view>
      <view class="chev"></view>
    </view>

    <view class="entry" bindtap="goToLottery" hover-class="entry-hover">
      <image class="entry-icon" src="/images/ic-lottery.png"></image>
      <view class="entry-body">
        <view class="entry-title">自律抽签</view>
        <view class="entry-desc">{{hasLotteryToday ? '今天已抽过签' : '每日一签，鹿还是不鹿'}}</view>
      </view>
      <view class="entry-dot" wx:if="{{!hasLotteryToday}}"></view>
      <view class="chev"></view>
    </view>

    <view class="entry" bindtap="goToMoments" hover-class="entry-hover">
      <image class="entry-icon" src="/images/ic-moments.png"></image>
      <view class="entry-body">
        <view class="entry-title">宿舍空间</view>
        <view class="entry-desc">发动态、晒照片，记下宿舍日常</view>
      </view>
      <view class="chev"></view>
    </view>

    <view class="entry" bindtap="goToHomework" hover-class="entry-hover">
      <view class="entry-icon entry-emoji">📚</view>
      <view class="entry-body">
        <view class="entry-title">作业共享</view>
        <view class="entry-desc">作业放这儿，谁都能拿</view>
      </view>
      <view class="chev"></view>
    </view>
  </view>

  <!-- 今晚速览 -->
  <view class="section-head"><text class="h">今晚</text></view>
  <view class="sheet tonight">
    <view class="fact">
      <view class="fact-label">最晚回来</view>
      <view class="fact-value" wx:if="{{latestCheckin}}">
        <text class="fact-name">{{latestCheckin.nickname}}</text>
        <text class="fact-time serif">{{latestCheckinTimeText}}</text>
      </view>
      <view class="fact-empty" wx:else>还没人登记</view>
    </view>
    <view class="fact">
      <view class="fact-label">最近抽签</view>
      <view class="fact-value" wx:if="{{latestLottery}}">
        <text class="fact-name">{{latestLottery.nickname}}</text>
        <text class="mark {{latestLottery.result === '鹿' ? 'mark-deer' : 'mark-leaf'}}">{{latestLottery.result}}</text>
      </view>
      <view class="fact-empty" wx:else>还没人抽签</view>
    </view>
  </view>

  <view class="colophon">六个人，一间屋</view>
</view>

<!-- 吃饭询问（底部抽屉） -->
<view class="modal-mask as-sheet" wx:if="{{showMealModal}}" bindtap="closeMealModal">
  <view class="modal-card meal-modal" catchtap="noop">
    <view class="grabber"></view>
    <view class="modal-title">吃饭询问</view>
    <view class="modal-subtitle">发起后，全宿舍都能在这里选</view>

    <view class="seg">
      <view class="seg-item {{mealTab === '中午' ? 'active' : ''}}" data-tab="中午" bindtap="switchMealTab">中午吃什么</view>
      <view class="seg-item {{mealTab === '下午' ? 'active' : ''}}" data-tab="下午" bindtap="switchMealTab">下午吃什么</view>
    </view>

    <!-- 中午 -->
    <block wx:if="{{mealTab === '中午'}}">
      <view wx:if="{{mealAskLunch}}" class="meal-body">
        <view class="meal-creator">{{mealAskLunch.creator}} 发起，{{mealAskLunch.answerCount}} 人已选</view>
        <view wx:for="{{mealAskLunch.options}}" wx:key="label"
              class="meal-option {{item.isMine ? 'mine' : ''}}"
              data-choice="{{item.label}}" bindtap="onChooseMealOption">
          <view class="meal-option-label">{{item.label}}</view>
          <view class="meal-option-voters" wx:if="{{item.votersText}}">{{item.votersText}}</view>
          <view class="meal-option-count" wx:if="{{item.count > 0}}">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="meal-empty">
        <view class="meal-empty-text">今天还没人问中午吃什么</view>
        <button class="btn-primary" bindtap="onCreateMealAsk">发起询问</button>
      </view>
    </block>

    <!-- 下午 -->
    <block wx:if="{{mealTab === '下午'}}">
      <view wx:if="{{mealAskDinner}}" class="meal-body">
        <view class="meal-creator">{{mealAskDinner.creator}} 发起，{{mealAskDinner.answerCount}} 人已选</view>
        <view wx:for="{{mealAskDinner.options}}" wx:key="label"
              class="meal-option {{item.isMine ? 'mine' : ''}}"
              data-choice="{{item.label}}" bindtap="onChooseMealOption">
          <view class="meal-option-label">{{item.label}}</view>
          <view class="meal-option-voters" wx:if="{{item.votersText}}">{{item.votersText}}</view>
          <view class="meal-option-count" wx:if="{{item.count > 0}}">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="meal-empty">
        <view class="meal-empty-text">今天还没人问下午吃什么</view>
        <button class="btn-primary" bindtap="onCreateMealAsk">发起询问</button>
      </view>
    </block>

    <!-- 提醒：转发到群 / 开启微信服务通知 -->
    <view class="meal-actions">
      <button class="btn-share" open-type="share">转发到宿舍群</button>
      <button class="btn-remind" bindtap="onEnableRemind" wx:if="{{subReady}}">
        开启微信提醒<text wx:if="{{subQuota > 0}}">（剩 {{subQuota}} 次）</text>
      </button>
    </view>
    <!-- 小程序未认证时微信会禁用转发，这里给一个不依赖认证的兜底 -->
    <view class="meal-copy-link" bindtap="onCopyMealText">转发不了？复制提醒文字</view>
  </view>
</view>

<!-- 引导设置昵称弹窗 -->
<view class="modal-mask {{keyboardUp ? 'keyboard-up' : ''}}" wx:if="{{showProfileModal}}" bindtap="closeProfileModal">
  <view class="modal-card" catchtap="noop">
    <view class="modal-title">欢迎回到宿舍</view>
    <view class="modal-subtitle">设个昵称和头像，室友才认得出你</view>

    <view class="form-item">
      <view class="form-label">头像</view>
      <view class="avatar-row">
        <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-large" src="{{avatarUrl || ''}}" wx:if="{{avatarUrl}}"></image>
          <view class="avatar-placeholder" wx:else>+</view>
        </button>
        <view class="avatar-side">
          <view class="avatar-tip">点圆形，用微信头像</view>
          <view class="avatar-album-link" bindtap="onPickAvatarFromAlbum">从相册选择</view>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">昵称</view>
      <input
        class="nickname-input"
        type="text"
        placeholder="室友平时怎么叫你"
        value="{{nicknameInitial}}"
        maxlength="20"
        adjust-position="{{false}}"
        bindinput="onNicknameInput"
        bindfocus="onNicknameFocus"
        bindblur="onNicknameBlur"
      />
    </view>

    <view class="modal-buttons">
      <button class="btn-primary" bindtap="onSaveProfile">开始使用</button>
    </view>
  </view>
</view>
