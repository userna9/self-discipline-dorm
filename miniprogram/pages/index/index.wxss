.page-index {
  padding: 40rpx 32rpx 64rpx;
}

/* ===== 问候 ===== */
.greet {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 8rpx;
}
.greet-hello {
  font-size: 40rpx;
  color: var(--ink-2);
  line-height: 1.3;
}
.greet-name {
  font-size: 64rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.25;
  letter-spacing: 2rpx;
}
.greet-date {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.greet-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--tint);
  border: 4rpx solid var(--sheet);
  flex-shrink: 0;
  margin-top: 8rpx;
}

/* ===== 宿舍楼 ===== */
.building {
  margin-top: 36rpx;
  position: relative;
}
/* 楼顶的一排树冠：宿舍站在鹿林里 */
.canopy {
  position: relative;
  height: 56rpx;
  margin: 0 20rpx -8rpx;
}
.tree {
  position: absolute;
  bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
}
.t1 { left: 0; width: 120rpx; height: 50rpx; background: var(--pine); }
.t2 { left: 84rpx; width: 150rpx; height: 64rpx; background: #24584a; }
.t3 { right: 150rpx; width: 110rpx; height: 40rpx; background: var(--moss); }
.t4 { right: 40rpx; width: 150rpx; height: 58rpx; background: #24584a; }
.t5 { right: 0; width: 90rpx; height: 38rpx; background: var(--pine); }

.facade {
  background: var(--pine-deep);
  border-radius: 28rpx;
  padding: 48rpx 44rpx 40rpx;
  position: relative;
  overflow: hidden;
}
/* 楼面的细竖纹，像外墙砖缝 */
.facade::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.025) 0, rgba(255, 255, 255, 0.025) 2rpx, transparent 2rpx, transparent 36rpx);
}
.windows {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-row-gap: 36rpx;
  grid-column-gap: 40rpx;
}
.window {
  height: 150rpx;
  border-radius: 10rpx 10rpx 6rpx 6rpx;
  background: #1f4a3a;
  box-shadow: inset 0 0 0 4rpx #2a5a47;
  position: relative;
}
/* 登记了、还没到：窗框先亮一圈暖光 */
.window.expect {
  box-shadow: inset 0 0 0 4rpx rgba(240, 180, 76, 0.75), 0 0 24rpx rgba(240, 180, 76, 0.18);
}
/* 窗棂 */
.pane {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}
.pane::before,
.pane::after {
  content: '';
  position: absolute;
  background: #2a5a47;
}
.pane::before { left: 50%; top: 0; bottom: 0; width: 4rpx; margin-left: -2rpx; }
.pane::after { top: 42%; left: 0; right: 0; height: 4rpx; }

/* 灯光：中心偏亮的暖光，亮起时轻轻闪一下 */
.glow {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: inherit;
  background: radial-gradient(circle at 50% 38%, #ffeac0 0%, #f6c66a 45%, #e3a23c 100%);
  box-shadow: 0 0 56rpx rgba(240, 180, 76, 0.38);
  opacity: 0;
}
.window.lit .glow {
  animation: light-up 0.9s ease-out both;
  animation-delay: inherit;
}
.window.lit .pane::before,
.window.lit .pane::after {
  background: rgba(110, 64, 8, 0.32);
}
@keyframes light-up {
  0% { opacity: 0; }
  30% { opacity: 1; }
  45% { opacity: 0.45; }
  100% { opacity: 1; }
}

.facade-foot {
  position: relative;
  margin-top: 44rpx;
}
.facade-line {
  font-size: 40rpx;
  color: #eaf1e6;
  letter-spacing: 2rpx;
}
.facade-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8fb39c;
}

/* ===== 入口 ===== */
.entries { padding: 0 32rpx; }
.entry {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--line);
  position: relative;
}
.entry:last-child { border-bottom: none; }
.entry-hover { opacity: 0.6; }
.entry-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
}
.entry-body {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.entry-desc {
  font-size: 25rpx;
  color: var(--ink-2);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 今天还没做的事：一颗小灯 */
.entry-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--lamp);
  box-shadow: 0 0 0 6rpx var(--lamp-soft);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 今晚 ===== */
.tonight { padding: 0 32rpx; }
.fact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.fact:last-child { border-bottom: none; }
.fact-label {
  font-size: 27rpx;
  color: var(--ink-2);
}
.fact-value {
  display: flex;
  align-items: center;
}
.fact-name {
  font-size: 28rpx;
  color: var(--ink);
  margin-right: 20rpx;
}
.fact-time {
  font-size: 40rpx;
  color: var(--pine);
  line-height: 1;
}
.fact-empty {
  font-size: 26rpx;
  color: var(--ink-3);
}

.colophon {
  margin-top: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
}

/* ===== 吃饭询问 ===== */
.meal-modal .seg { margin-bottom: 32rpx; }
.meal-creator {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
}
.meal-option {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: var(--mist);
  margin-bottom: 16rpx;
  transition: background 0.2s;
}
.meal-option-label {
  font-size: 29rpx;
  color: var(--ink);
  flex-shrink: 0;
}
.meal-option-voters {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meal-option-count {
  margin-left: 20rpx;
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 22rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--sheet);
  color: var(--pine);
  padding: 0 10rpx;
  box-sizing: border-box;
}
.meal-option.mine { background: var(--pine); }
.meal-option.mine .meal-option-label { color: #fff; font-weight: 600; }
.meal-option.mine .meal-option-voters { color: rgba(255, 255, 255, 0.7); }
.meal-option.mine .meal-option-count { background: var(--lamp); color: var(--pine-deep); }

.meal-empty {
  padding: 40rpx 0 16rpx;
  text-align: center;
}
.meal-empty-text {
  font-size: 27rpx;
  color: var(--ink-2);
  margin-bottom: 32rpx;
}

.meal-actions {
  display: flex;
  margin-top: 32rpx;
}
.meal-actions button {
  flex: 1;
  margin: 0;
  font-size: 27rpx;
  line-height: 1.4;
  padding: 22rpx 0;
  border-radius: 999rpx;
}
.meal-actions button + button { margin-left: 20rpx; }
.btn-share {
  background: var(--tint);
  color: var(--pine);
  font-weight: 600;
}
.btn-remind {
  background: var(--lamp-soft);
  color: #8a5a12;
  font-weight: 600;
}
.meal-copy-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  text-decoration: underline;
}

.courtyard-entry{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:30rpx;margin-top:30rpx;background:#d2e3ce;border-radius:24rpx;color:#163b2e}.courtyard-kicker{font-size:21rpx;letter-spacing:3rpx;color:#5c7965}.courtyard-heading{font-family:var(--serif);font-size:35rpx;margin:8rpx 0}.courtyard-caption{font-size:22rpx;color:#5c7965}.courtyard-enter{font-size:25rpx;flex-shrink:0;border-bottom:1rpx solid #7fa88b;padding:12rpx 0}

/* 作业共享入口用 emoji 当图标，和图片图标对齐 */
.entry-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}
